{
  "schemaVersion": 1,
  "id": "naturoforumsmp",
  "version": "${version}",
  "name": "NaturoForumSMP Mod",
  "description": "Client-side tweaks for the NaturoForumSMP server, including automatic elytra swapping.",
  "authors": [
    "Profiidev"
  ],
  "contact": {
    "homepage": "https://github.com/Profiidev/NaturoForumSMP-Mod",
    "sources": "https://github.com/Profiidev/NaturoForumSMP-Mod",
    "issues": "https://github.com/Profiidev/NaturoForumSMP-Mod/issues"
  },
  "license": "GPL-2.0-only",
  "icon": "assets/naturoforumsmp/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.profidev.naturoForumSMP.fabric.NaturoForumSMPFabric"
    ],
    "modmenu": [
      "io.profidev.naturoForumSMP.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "naturoforumsmp.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "java": ">=25",
    "architectury": ">=22.0.3"
  },
  "suggests": {
    "cloth-config": "*"
  },
  "contributors": [
    "NimajnebEC (original AutoElytra code)"
  ]
}
